# NammaTrip AI — Environment Variables Example
# Copy this file to .env.local to configure your environment variables.
# NOTE: The application functions 100% out-of-the-box using the built-in deterministic
# fallback planner even if GEMINI_API_KEY is not configured.

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Gemini Model Name (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Base URL (Used for metadata and canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
